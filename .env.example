# Django Configuration
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite in development; supports PostgreSQL/MySQL)
DATABASE_URL=sqlite:///db.sqlite3

# Cryptography - Application-Level AES-256-GCM Master Key (32 bytes base64 encoded)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=replace-with-a-secure-base64-encoded-32-byte-key

# File Upload Settings
MAX_UPLOAD_SIZE_MB=25

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
